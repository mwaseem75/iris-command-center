# ---- InterSystems IRIS connection ----
IRIS_BASE_URL=https://iris.example.local:52773
IRIS_USERNAME=changeme
IRIS_PASSWORD=changeme

# ---- AI provider configuration (optional, not implemented in Phase 0) ----
AI_PROVIDER=
AI_API_KEY=
AI_MODEL=

# ---- Application host and port ----
APP_HOST=0.0.0.0
APP_PORT=8000
