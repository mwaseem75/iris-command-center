# -----------------------------------------------------------------------------
# IRIS Command Center — Docker Compose configuration template.
# Copy this file to `.env` (next to docker-compose.yml). Never commit `.env`.
# -----------------------------------------------------------------------------

# ---- IRIS login used by the Command Center backend ----
# Must match the IRIS instance's own credentials. The values below are the
# documented development defaults of the intersystemsdc/iris-community image
# that docker-compose.yml runs — change them for anything beyond local use.
IRIS_USERNAME=_SYSTEM
IRIS_PASSWORD=SYS
