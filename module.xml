<?xml version="1.0" encoding="UTF-8"?>
<Export generator="Cache" version="25">
  <Document name="iris-command-center.ZPM">
    <Module>
      <Name>iris-command-center</Name>
      <Version>1.0.1</Version>
      <Description>IRIS Command Center: administration and observability console for InterSystems IRIS. Installs the web console at /iris-command-center/ (the FastAPI backend is run separately, e.g. docker compose up).</Description>
      <Keywords>administration observability monitoring console</Keywords>
      <Packaging>module</Packaging>
      <SourcesRoot>.</SourcesRoot>

      <!-- The static web console (frontend/), copied into IRIS's CSP directory
           and served at /iris-command-center/index.html. ServeFiles="1" serves
           these static files without an IRIS login (they contain no data; all
           data comes from the Command Center backend). -->

      <CSPApplication
        Url="/iris-command-center"
        SourcePath="/frontend"
        DeployPath="${cspdir}iris-command-center"
        ServeFiles="1"
        Recurse="1"
        ServeFilesTimeout="0"
        CookiePath="/iris-command-center/"
        PasswordAuthEnabled="1"
        UnauthenticatedEnabled="0"
        MatchRoles=":${dbrole}"/>
    </Module>
  </Document>
</Export>
