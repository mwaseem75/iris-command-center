# -----------------------------------------------------------------------------
# IRIS Command Center backend — environment configuration template.
# Copy to `backend/.env` and fill in real values. Never commit `.env`.
# Configuration NAMES only below — no real credentials.
# -----------------------------------------------------------------------------

# ---- IRIS connection ----
IRIS_BASE_URL=https://iris.example.local:52773
IRIS_USERNAME=changeme
IRIS_PASSWORD=changeme

# ---- IRIS request behavior ----
IRIS_REQUEST_TIMEOUT_SECONDS=10.0

# ---- Command Center application server ----
APP_HOST=0.0.0.0
APP_PORT=8000

# ---- Optional IRIS Vector Search knowledge base (off by default) ----
# When true, startup creates CommandCenter.Knowledge in IRIS_NAMESPACE (default
# USER) if missing and reindexes the corpus, over the Native API superserver port.
# ENABLE_KNOWLEDGE_SEARCH=false
# IRIS_NAMESPACE=USER
# IRIS_SUPERSERVER_PORT=1973

# ---- Optional one-time automatic Demo Activity (off by default) ----
# When true, the existing Demo Activity rehearsal runs once after startup; a
# marker (^CommandCenterDemo) in IRIS_NAMESPACE keeps it from repeating.
# AUTO_RUN_DEMO_ACTIVITY=false
