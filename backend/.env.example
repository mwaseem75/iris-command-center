# -----------------------------------------------------------------------------
# IRIS Command Center backend — environment configuration template.
# Copy to `backend/.env` and fill in real values. Never commit `.env`.
# Configuration NAMES only below — no real credentials.
# -----------------------------------------------------------------------------

# ---- IRIS connection ----
IRIS_BASE_URL=https://iris.example.local:52773
IRIS_USERNAME=changeme
IRIS_PASSWORD=changeme

# ---- IRIS request behavior ----
IRIS_REQUEST_TIMEOUT_SECONDS=10.0

# ---- Command Center application server ----
APP_HOST=0.0.0.0
APP_PORT=8000
